includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 8

    paths:
        - app
        - modules
        - bootstrap/app.php
        - config
        - routes

    excludePaths:
        - modules/*/Database/Migrations/*
        # Test suites are covered by Pest, not static analysis (mirrors the
        # top-level tests/ directory being out of scope).
        - modules/*/Tests/*

    tmpDir: .phpstan.cache

    ignoreErrors:
        # Stock Laravel config files: env() is typed string|bool and the
        # framework's own published configs feed it straight into string funcs.
        - message: '#Parameter \#(1|2) \$string of function (rtrim|explode) expects string, bool\|string given\.#'
          paths:
            - config/filesystems.php
            - config/sanctum.php
        # Laravel's factory-name resolver closure — signature is stock artisan.
        - message: '#guessFactoryNamesUsing\(\) expects callable#'
          path: app/Providers/AppServiceProvider.php
        # Eloquent decimal:4-cast attributes (Stock/InventoryMovement.quantity,
        # unit_cost) are runtime-guaranteed numeric strings, but Larastan can't
        # narrow a cast's inferred type past plain `string` — bcmath's stubs
        # require the stricter `numeric-string`.
        - message: '#Parameter \#(1|2) \$num[12] of function (bcadd|bccomp) expects numeric-string, string given\.#'
          paths:
            - modules/Inventory/Services/InventoryLedger.php
            - modules/Inventory/Console/Commands/ReconcileInventoryCommand.php

    checkModelProperties: true
    checkOctaneCompatibility: false
