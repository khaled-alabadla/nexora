# ---------------------------------------------------------------------------
# Docker Compose interpolation variables (repo root).
#
# Copy to `.env`:  cp .env.example .env
#
# This file configures the *infrastructure* (host port mappings, image build
# args). The Laravel application is configured separately in backend/.env.
# ---------------------------------------------------------------------------

# Match your host user so bind-mounted files stay writable (Linux/macOS).
# On Windows Docker Desktop these are ignored; leave the defaults.
UID=1000
GID=1000

# Host ports. Defaults avoid clashing with a locally-installed MySQL/Redis.
APP_FORWARD_PORT=8000
DB_FORWARD_PORT=33061
REDIS_FORWARD_PORT=63790
VITE_FORWARD_PORT=5173
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# MySQL bootstrap credentials (used by the mysql container on first start).
# Keep these in sync with backend/.env.
DB_DATABASE=nexora
DB_USERNAME=nexora
DB_PASSWORD=secret
DB_ROOT_PASSWORD=root

# Set to "debug" (and restart `app`) to enable Xdebug; "off" for normal speed.
XDEBUG_MODE=off

# MySQL image. Default mysql:8.0 (see ADR-0005); mysql:8.4 once available.
MYSQL_IMAGE=mysql:8.0
