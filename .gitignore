# ─── Environment / secrets ───────────────────────────────
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key
auth.json

# ─── Backend (Laravel / PHP) ─────────────────────────────
/backend/vendor/
/backend/node_modules/
/backend/public/build/
/backend/public/hot
/backend/storage/*.key
/backend/storage/app/*
