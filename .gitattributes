# Normalize line endings: LF in the repo, regardless of host OS.
* text=auto eol=lf

# Explicitly text
*.php     text eol=lf
*.js      text eol=lf
*.jsx     text eol=lf
*.ts      text eol=lf
*.tsx     text eol=lf
*.json    text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.xml     text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.blade.php text eol=lf
*.sh      text eol=lf
Makefile  text eol=lf
Dockerfile text eol=lf
.env.example text eol=lf

# Binary
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.woff    binary
*.woff2   binary
*.ttf     binary
*.eot     binary
*.pdf     binary

# Keep generated / vendored files out of diffs and language stats
/backend/composer.lock  -diff
/frontend/package-lock.json -diff
*.lock linguist-generated=true
